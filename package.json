{
  "name": "ai-personal-finance-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "Modular monolith implementation of the frozen AI Personal Finance Assistant PRD (Architecture Freeze v1.0). See IMPLEMENTATION-BLUEPRINT.md and ENGINEERING-TASK-BREAKDOWN.md in the PRD repository for the governing architecture and backlog.",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.13.0",
    "pnpm": ">=11.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint -- --fix",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,js,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,js,json,md,yml,yaml}\"",
    "prepare": "husky",
    "prisma:generate": "pnpm --filter @afa/infrastructure run prisma:generate",
    "prisma:migrate:deploy": "pnpm --filter @afa/infrastructure run prisma:migrate:deploy",
    "prisma:seed": "pnpm --filter @afa/infrastructure run prisma:seed"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "9.39.5",
    "@typescript-eslint/eslint-plugin": "8.66.0",
    "@typescript-eslint/parser": "8.66.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "prettier": "3.9.6",
    "rimraf": "6.1.3",
    "turbo": "2.10.9",
    "typescript": "5.9.3"
  }
}
