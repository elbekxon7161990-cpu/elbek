# Never commit a real .env (FR-SCR-M-001). Real values come from the
# secrets manager at deploy time (FR-SCR-M-002).
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL="postgresql://app_user:CHANGE_ME@localhost:5432/afa?schema=public"
# TASK-MVP-002 — required by prisma/schema.prisma's `directUrl` (used only
# by `prisma migrate`/`prisma db seed`, never by the app at runtime). Equal
# to DATABASE_URL for a plain local/docker-compose Postgres; for a pooled
# managed Postgres (e.g. Supabase's pgbouncer endpoint), point this at the
# same database's non-pooled/session-mode connection instead.
DIRECT_URL="postgresql://app_user:CHANGE_ME@localhost:5432/afa?schema=public"
REDIS_URL="redis://localhost:6379"
OTEL_SERVICE_NAME=afa-worker
OTEL_EXPORTER_OTLP_ENDPOINT=

# Real SttProvider (OpenAI Whisper) — a deliberately separate vendor/
# credential from ANTHROPIC_API_KEY (this app also needs that; see the
# ANTHROPIC_API_KEY/OCR/LLM entries documented elsewhere in this app's own
# real configuration — omitted from this pre-existing example file before
# this variable was added). Claude has no audio-transcription API, so
# Speech-to-Text uses OpenAI's Whisper endpoint instead. Without
# OPENAI_API_KEY, the app fails to start unless ALLOW_FAKE_STT_PROVIDER is
# explicitly set (local development only — never in production).
OPENAI_API_KEY="CHANGE_ME"
OPENAI_STT_MODEL=whisper-1
ALLOW_FAKE_STT_PROVIDER=false
