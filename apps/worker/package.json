{
  "name": "@afa/worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker bootstrap (Chapter 3 §3.3.3 Job Queue & Worker Pool). Executes queues only — no HTTP surface, no Telegram transport, no business logic of its own; processors (added from Phase 5 onward) call into @afa/application use-cases.",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@afa/application": "workspace:*",
    "@afa/domain": "workspace:*",
    "@afa/infrastructure": "workspace:*",
    "@afa/shared": "workspace:*",
    "@nestjs/bullmq": "11.0.5",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "bullmq": "5.81.3",
    "ioredis": "5.11.1",
    "nestjs-pino": "4.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@types/node": "22.20.1",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
