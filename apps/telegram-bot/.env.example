# Never commit a real .env (FR-SCR-M-001). Real values come from the
# secrets manager at deploy time (FR-SCR-M-002).
NODE_ENV=development
LOG_LEVEL=info
DATABASE_URL="postgresql://app_user:CHANGE_ME@localhost:5432/afa?schema=public"
# TASK-MVP-002 — required by prisma/schema.prisma's `directUrl` (used only
# by `prisma migrate`/`prisma db seed`, never by the app at runtime). Equal
# to DATABASE_URL for a plain local/docker-compose Postgres; for a pooled
# managed Postgres (e.g. Supabase's pgbouncer endpoint), point this at the
# same database's non-pooled/session-mode connection instead.
DIRECT_URL="postgresql://app_user:CHANGE_ME@localhost:5432/afa?schema=public"
REDIS_URL="redis://localhost:6379"
TELEGRAM_BOT_TOKEN="CHANGE_ME"
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=
OTEL_SERVICE_NAME=afa-telegram-bot
OTEL_EXPORTER_OTLP_ENDPOINT=

# TASK-INFRA-AI-REAL-001 — real LlmProvider (Anthropic Claude). Without
# ANTHROPIC_API_KEY, the app fails to start unless ALLOW_FAKE_LLM_PROVIDER
# is explicitly set (local development only — never in production).
ANTHROPIC_API_KEY="CHANGE_ME"
ANTHROPIC_MODEL=claude-sonnet-5
# TASK-MVP-002 — leave ANTHROPIC_TEMPERATURE/ANTHROPIC_MAX_OUTPUT_TOKENS
# unset (do not add them as blank `KEY=` lines): `plainToInstance`'s
# `enableImplicitConversion` coerces a blank value to `NaN` before
# `@IsOptional()` can skip it, which then fails `@Min(1)`/`@IsInt()`
# validation at startup. Omitting the key entirely is the correct way to
# leave these optional.
ALLOW_FAKE_LLM_PROVIDER=false

# TASK-FIN-REAL-001 — real TransactionCommitPort (Prisma/PostgreSQL). No
# fail-fast gate here (DATABASE_URL above is already mandatory) — this is a
# pure, explicit opt-out of real persistence for local development only.
ALLOW_FAKE_TRANSACTION_COMMIT=false
