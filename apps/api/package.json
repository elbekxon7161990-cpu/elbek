{
  "name": "@afa/api",
  "version": "0.1.0",
  "private": true,
  "description": "API bootstrap (Chapter 3 §3.3.1 API Gateway / Chapter 14 REST API). Exposes REST endpoints only — every response is produced by calling into @afa/application use-cases; no business logic lives in this app (this turn's explicit instruction, consistent with IMPLEMENTATION-BLUEPRINT.md §2's package-boundary discipline).",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js",
    "dev": "ts-node -r tsconfig-paths/register src/main.ts",
    "admin:bootstrap": "ts-node -r tsconfig-paths/register src/admin-bootstrap.ts",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "clean": "rimraf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@afa/application": "workspace:*",
    "@afa/domain": "workspace:*",
    "@afa/infrastructure": "workspace:*",
    "@afa/shared": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.1.28",
    "@nestjs/swagger": "11.4.6",
    "@nestjs/terminus": "11.1.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "nestjs-pino": "4.6.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/testing": "11.1.28",
    "@swc/core": "^1.16.1",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "otplib": "13.5.0",
    "rimraf": "6.1.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsconfig-paths": "4.2.0",
    "typescript": "5.9.3",
    "unplugin-swc": "^1.5.11",
    "vitest": "3.2.7"
  }
}
